  "scripts": {
    "dark-mode": { "url": "scripts/dark-mode.js", "title": "Dark Mode", "icon": "eye", "requires": ["darkreader"], "category": "Reading", "description": "Dark theme for every site, per-site off switch" },
    "reader-mode": { "url": "scripts/reader-mode.js", "title": "Reader View", "icon": "layout", "requires": ["readability", "dompurify"], "category": "Reading", "description": "Clean article view (Alt+Shift+R)" },
    "unstick": { "url": "scripts/unstick.js", "title": "Unstick", "icon": "eraser", "category": "Reading", "description": "Kill sticky headers, modals, scroll locks (Alt+Shift+K)" },
    "unlock-page": { "url": "scripts/unlock-page.js", "title": "Unlock Page", "icon": "check", "category": "Page Tools", "description": "Re-enable right-click, select and copy" },
    "edit-page": { "url": "scripts/edit-page.js", "title": "Edit Page", "icon": "edit", "category": "Page Tools", "description": "Make any page editable (Alt+Shift+E)" },
    "markdown-copy": { "url": "scripts/markdown-copy.js", "title": "Markdown Copy", "icon": "copy", "requires": ["turndown", "readability"], "category": "Page Tools", "description": "Copy selection / article as Markdown (Alt+Shift+M)" },
    "link-extractor": { "url": "scripts/link-extractor.js", "title": "Links", "icon": "list", "category": "Page Tools", "description": "Every link, filter, copy, CSV" },
    "image-grabber": { "url": "scripts/image-grabber.js", "title": "Images", "icon": "download", "requires": ["jszip"], "category": "Media", "description": "List all images, download as ZIP" },
    "media-control": { "url": "scripts/media-control.js", "title": "Media Speed", "icon": "sliders", "category": "Media", "description": "Video speed (Alt+[ / Alt+]), PiP, loop" },
    "screenshot": { "url": "scripts/screenshot.js", "title": "Screenshot", "icon": "monitor", "requires": ["html2canvas"], "category": "Media", "description": "Save visible area or full page as PNG (Alt+Shift+S)" },
    "qr-share": { "url": "scripts/qr-share.js", "title": "QR Share", "icon": "grid", "requires": ["qrcode"], "category": "Media", "description": "QR code of this page or any text (Alt+Shift+Q)" }
  }
